{
  "$schema": "https://mintlify.com/schema.json",
  "theme": "mint",
  "name": "Aptove",
  "logo": {
    "dark": "/logo-dark.svg",
    "light": "/logo-light.svg",
    "href": "https://aptove.com"
  },
  "favicon": "/favicon.svg",
  "modeToggle": {
    "default": "dark",
    "isHidden": true
  },
  "colors": {
    "primary": "#6366f1",
    "light": "#818cf8",
    "dark": "#4f46e5"
  },
  "topbarLinks": [
    {
      "name": "aptove.com",
      "url": "https://aptove.com"
    }
  ],
  "topbarCtaButton": {
    "name": "GitHub",
    "url": "https://github.com/aptove"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["introduction"]
          },
          {
            "group": "Aptove Router",
            "pages": [
              "aptove/overview",
              "aptove/install",
              "aptove/agent",
              "aptove/configuration",
              {
                "group": "Transports",
                "pages": [
                  "aptove/transports",
                  "aptove/local-transport",
                  "aptove/tailscale-transport"
                ]
              },
              "aptove/sessions",
              "aptove/slash-commands",
              "aptove/memory",
              "aptove/computer-files",
              "aptove/logs",
              "aptove/tui",
              "aptove/keep-alive",
              "aptove/security",
              {
                "group": "Advanced",
                "pages": [
                  "aptove/advanced/agent-id",
                  "aptove/advanced/agent-name",
                  "aptove/advanced/memory-injection",
                  "aptove/advanced/session-resumption",
                  "aptove/advanced/session-load-error",
                  "aptove/advanced/commands-injection",
                  "aptove/advanced/memory-consolidation"
                ]
              }
            ]
          },
          {
            "group": "Mobile App",
            "pages": [
              "mobile-app/overview",
              "mobile-app/pairing",
              "mobile-app/features",
              "mobile-app/voice-input"
            ]
          },
          {
            "group": "Push Notifications",
            "pages": [
              "push-server/overview",
              "push-server/architecture",
              "push-server/cf-push-relay",
              "push-server/cf-token",
              "push-server/deploy",
              "push-server/apple-apns-setup",
              "push-server/firebase-fcm-setup"
            ]
          }
        ]
      }
    ]
  },
  "footerSocials": {
    "github": "https://github.com/aptove",
    "discord": "https://discord.gg/gD7AMxBy9y"
  }
}
