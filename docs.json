{
  "$schema": "https://mintlify.com/schema.json",
  "theme": "mint",
  "name": "Aptove",
  "logo": {
    "dark": "/logo-dark.svg",
    "light": "/logo-light.svg",
    "href": "https://aptove.com"
  },
  "favicon": "/favicon.svg",
  "modeToggle": {
    "default": "dark",
    "isHidden": true
  },
  "colors": {
    "primary": "#6366f1",
    "light": "#818cf8",
    "dark": "#4f46e5"
  },
  "topbarLinks": [
    {
      "name": "aptove.com",
      "url": "https://aptove.com"
    }
  ],
  "topbarCtaButton": {
    "name": "GitHub",
    "url": "https://github.com/aptove"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["introduction"]
          },
          {
            "group": "Bridge",
            "pages": [
              "bridge/overview",
              "bridge/install",
              "bridge/agent",
              "bridge/configuration",
              {
                "group": "Transports",
                "page": "bridge/transports",
                "pages": [
                  "bridge/local-transport",
                  "bridge/tailscale-transport"
                ]
              },
              "bridge/sessions",
              "bridge/slash-commands",
              "bridge/memory",
              "bridge/logs",
              "bridge/tui",
              "bridge/security",
              {
                "group": "Advanced",
                "pages": [
                  "bridge/advanced/agent-id"
                ]
              }
            ]
          },
          {
            "group": "Mobile App",
            "pages": [
              "mobile-app/overview",
              "mobile-app/pairing",
              "mobile-app/features"
            ]
          },
          {
            "group": "Push Notifications",
            "pages": [
              "push-server/overview",
              "push-server/architecture",
              "push-server/cf-push-relay",
              "push-server/cf-token",
              "push-server/deploy",
              "push-server/apple-apns-setup",
              "push-server/firebase-fcm-setup"
            ]
          }
        ]
      }
    ]
  },
  "footerSocials": {
    "github": "https://github.com/aptove",
    "discord": "https://discord.gg/gD7AMxBy9y"
  }
}
